# Xendit (task 008)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# WhatsApp — hanya deep-link aktivasi vendor (Cloud API dihapus 2026-09-12)
NEXT_PUBLIC_WA_ADMIN_NUMBER=6281234567890

# Monitoring (task 015) — proteksi cron (pinger eksternal: cron-job.org / UptimeRobot)
CRON_SECRET=

# Opsional — override API base (default sudah menunjuk produksi)
XENDIT_API_BASE=https://api.xendit.co

