{
  "crons": [
    {
      "path": "/api/cron/photo-ttl",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/subscription-expiry",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/wa-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/wa-queue",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/p/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self)"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.temora.id"
        }
      ],
      "destination": "https://temora.id/:path*",
      "permanent": true
    }
  ]
}
